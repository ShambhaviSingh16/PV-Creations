{
 "name": "pv-creations-api",
 "main": "worker.js",
 "compatibility_date": "2026-10-01",
 "assets": {"directory":"../dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "d1_databases": [{"binding":"DB","database_name":"pv-creations","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID","migrations_dir":"migrations"}],
 "r2_buckets": [{"binding":"PRODUCT_IMAGES","bucket_name":"pv-creations-product-images"}],
 "triggers": {"crons":["*/10 * * * *"]},
 "vars": {
   "ALLOWED_ORIGINS":"https://www.pvcreations.com,https://pvcreations.com",
   "PAYMENTS_ENABLED":"false",
   "CATALOG_APPROVED":"false",
   "POLICIES_APPROVED":"false",
   "BUSINESS_WHATSAPP":"919380250104",
   "CONTACT_EMAIL":"",
   "STOREFRONT_URL":"https://www.pvcreations.com",
   "SHIPPING_POLICY":"",
   "RETURNS_POLICY":"",
   "PRIVACY_POLICY":"",
   "TERMS_POLICY":"",
   "SHIPPING_RULES":"null"
 }
}
