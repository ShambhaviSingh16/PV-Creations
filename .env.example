# Frontend: optional. Leave empty to keep the production frontend in preview mode.
# For local development the default API is http://127.0.0.1:8787.
VITE_API_URL=
# Optional protected owner dashboard URL, e.g. https://your-backend-host/admin.
# Without this, a configured production API URL supplies /admin; otherwise /#admin opens the sign-in screen.
VITE_ADMIN_URL=
